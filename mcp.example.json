{
  "mcpServers": {
    "ctf-tools": {
      "command": "path\\to\\ctf-tools\\.venv\\Scripts\\python.exe",
      "args": [
        "path\\to\\ctf-tools\\mcp_server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "CTFKIT_MCP_PROFILE": "simple"
      },
      "description": "CTF Kit — simple MCP profile with access to all registered tools",
      "timeout": 300,
      "disabled": false
    }
  }
}
